# Port the Express server listens on.
PORT=3000

# Optional: enables smart LLM-based workout generation via any OpenAI-compatible
# "chat completions" API. Without it, the server falls back to a deterministic
# local generator that still guarantees the right mix of cardio / strength /
# stretch / martial arts.
# Defaults target Mammouth AI (https://mammouth.ai) — check their Model
# Explorer for the exact model id you have access to. Any other
# OpenAI-compatible endpoint (OpenAI itself, another proxy) also works by
# changing LLM_BASE_URL.
LLM_API_KEY=
LLM_BASE_URL=https://api.mammouth.ai/v1
LLM_MODEL=claude-sonnet-5

# Optional: enables AI-generated exercise illustrations (cached to disk and
# reused for every future workout containing the same exercise). Without it,
# the /api/exercises/:slug/image endpoint returns 404 and the app falls back
# to a bundled category icon.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
