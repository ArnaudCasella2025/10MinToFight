# Port the Express server listens on.
PORT=3000

# Optional: enables smart LLM-based workout generation via the Claude API.
# Without it, the server falls back to a deterministic local generator that
# still guarantees the right mix of cardio / strength / stretch / martial arts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: enables AI-generated exercise illustrations (cached to disk and
# reused for every future workout containing the same exercise). Without it,
# the /api/exercises/:slug/image endpoint returns 404 and the app falls back
# to a bundled category icon.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
